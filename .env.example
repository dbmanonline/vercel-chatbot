# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# MCP integration with Night Worker
# Enable MCP tool calling for business data queries
MCP_ENABLED=true
# Night Worker MCP endpoint URL (e.g. https://night-worker-staging.example.com/mcp)
MCP_SERVER_URL=
# Bearer token from Night Worker MCP_AUTH_TOKEN (min 32 chars)
MCP_AUTH_TOKEN=
# Optional: MCP request timeout in milliseconds
MCP_TIMEOUT_MS=30000
